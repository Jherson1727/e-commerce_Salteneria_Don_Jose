# Copia este archivo como .env.local (no se sube a GitHub).
# En Vercel, las dos primeras se registran en Settings → Environment Variables.

# --- Solo servidor (sin prefijo VITE_: nunca llegan al navegador) ---
# URL base de Dolibarr, SIN /api/index.php
#   local: http://localhost:8080   ·   con túnel: https://<tu-dominio>.ngrok-free.app
DOLIBARR_URL=http://localhost:8080
# API key del usuario de servicio "ecommerce" (Usuarios y grupos → ecommerce → Clave para API)
DOLIBARR_API_KEY=

# --- Configuración pública de la tienda (no son secretos) ---
VITE_DOLIBARR_CLIENTE_WEB=Cliente Web
VITE_DOLIBARR_ALMACEN=ALM-POS
# Cuenta bancaria donde entran los cobros QR y modo de pago (VIR = transferencia)
VITE_DOLIBARR_CUENTA=BANCO-QR
VITE_DOLIBARR_MODO_PAGO=VIR
