# Copia este archivo como .env.local (no se sube a GitHub) y completa la API key
# del usuario "ecommerce" de Dolibarr (Usuarios y grupos → ecommerce → Clave para API).
VITE_DOLIBARR_URL=http://localhost:8080/api/index.php
VITE_DOLIBARR_API_KEY=
VITE_DOLIBARR_CLIENTE_WEB=Cliente Web
VITE_DOLIBARR_ALMACEN=ALM-POS
# Cuenta bancaria donde entran los cobros QR y modo de pago (VIR = transferencia)
VITE_DOLIBARR_CUENTA=BANCO-QR
VITE_DOLIBARR_MODO_PAGO=VIR
